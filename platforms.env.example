# Optional HPC Platform Profiles for Docker Compose. Copy to platforms.env (ignored
# by git), or point NEST_PLATFORMS_ENV_FILE at another file. Compose passes every
# line to the Controller unchanged; a native Controller reads the same variables
# from its process environment. Do not combine with the NEST_SLURM_* settings in
# .env. See docs/source/configuration.md, "HPC Platforms".
#
# The Platform ID (lowercase, from NEST_PLATFORMS) is the Platform's permanent
# identity: it namespaces Slurm accounts and job records. Use a new ID for a
# different cluster. Keep secrets such as NEST_SSH_PRIVATE_KEY out of this file.
NEST_PLATFORMS=campus,lab
NEST_DEFAULT_PLATFORM=campus

NEST_PLATFORM_CAMPUS_NAME=Campus GPU cluster
NEST_PLATFORM_CAMPUS_OPERATOR=example-university
NEST_PLATFORM_CAMPUS_SSH_MODE=B
NEST_PLATFORM_CAMPUS_LOGIN_NODES=login1.example.edu,login2.example.edu:2222
NEST_PLATFORM_CAMPUS_SSH_USER=svc-nest
NEST_PLATFORM_CAMPUS_ACCOUNT=physics
NEST_PLATFORM_CAMPUS_PARTITION=gpu
NEST_PLATFORM_CAMPUS_TIME=02:00:00
NEST_PLATFORM_CAMPUS_WORKDIR=/scratch/svc-nest/nest

NEST_PLATFORM_LAB_NAME=Lab cluster
NEST_PLATFORM_LAB_OPERATOR=example-university
NEST_PLATFORM_LAB_SSH_MODE=B
NEST_PLATFORM_LAB_LOGIN_NODES=lab-login.example.edu
NEST_PLATFORM_LAB_SSH_USER=svc-nest
NEST_PLATFORM_LAB_ACCOUNT=lab
NEST_PLATFORM_LAB_PARTITION=short
NEST_PLATFORM_LAB_TIME=00:30:00
NEST_PLATFORM_LAB_WORKDIR=/home/svc-nest/nest
