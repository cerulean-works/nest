# Copy to .env next to compose.yaml and fill in the Slurm settings.
NEST_EXECUTOR=slurm
NEST_SLURM_HOST=hpc
NEST_SLURM_ACCOUNT=your-slurm-account
NEST_SLURM_WORKDIR=/home/your-user/nest

# Host directory containing config, known_hosts, and a dedicated SSH key.
NEST_SSH_DIR=./ssh

# Use the host's Tailscale IPv4 address to accept connections from your Tailnet.
NEST_CONTROLLER_HOST_IP=127.0.0.1
NEST_CONTROLLER_PORT=50051
