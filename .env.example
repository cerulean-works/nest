# Copy to .env next to compose.yaml and fill in the Slurm settings.
NEST_EXECUTOR=slurm
NEST_SLURM_HOST=hpc
NEST_SLURM_ACCOUNT=your-slurm-account
NEST_SLURM_WORKDIR=/home/your-user/nest

# Host directory containing config, known_hosts, and a dedicated SSH key.
NEST_SSH_DIR=./ssh

# Use the host's Tailscale IPv4 address to accept connections from your Tailnet.
NEST_CONTROLLER_HOST_IP=127.0.0.1
NEST_CONTROLLER_PORT=50051

# Optional outbound Tailnet access: use compose.tailscale.yaml instead of compose.yaml.
# Auth key contents belong ONLY in this ignored file (Dokploy: ../files/tailscale/authkey).
NEST_TAILSCALE_AUTHKEY_FILE=./secrets/tailscale-authkey
NEST_TAILSCALE_HOSTNAME=nest-controller
# Override with a reviewed official image version or digest when updating.
NEST_TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4

# Shared-team inbound gRPC: use compose.tailscale-shared.yaml alone.
# Dokploy: ../files/tailscale/serve containing the reviewed serve.json.
NEST_TAILSCALE_SERVE_DIR=./docker/tailscale-serve
