# Optional. Compose reads .env next to compose.yaml; exporting the same variables in
# the shell works too, and a native `python -m nest.controller` reads only the
# process environment. See docs/source/configuration.md for the full contract.
NEST_EXECUTOR=slurm
# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
NEST_LOG_LEVEL=INFO

# --- Provider Profile "default" ---------------------------------------------
NEST_SLURM_ACCOUNT=your-slurm-account
NEST_SLURM_WORKDIR=/home/your-user/nest
# NEST_SLURM_PARTITION=dev
# NEST_SLURM_TIME=00:05:00

# Mode A (trusted operator SSH): an alias from the mounted ssh/config.
NEST_SLURM_HOST=hpc
# Host directory containing config, known_hosts, and a dedicated SSH key.
NEST_SSH_DIR=./ssh

# Mode B (managed SSH): unset NEST_SLURM_HOST and use compose.managed-ssh.yaml.
# No SSH config or Tailscale setting is read. Host keys are public. The key is a
# secret: set NEST_SSH_PRIVATE_KEY from your platform's secret store or shell,
# never in this file.
# NEST_SLURM_SSH_MODE=B
# NEST_SLURM_LOGIN_NODES=login1.example.edu,login2.example.edu:2222
# NEST_SLURM_SSH_USER=svc-nest
# NEST_SSH_KNOWN_HOSTS_DATA="login1.example.edu ssh-ed25519 AAAA...\nlogin2.example.edu ssh-ed25519 AAAA..."
# NEST_SSH_MODES_ALLOWED=A,B

# --- Service -----------------------------------------------------------------
# Use the host's Tailscale IPv4 address to accept connections from your Tailnet.
NEST_CONTROLLER_HOST_IP=127.0.0.1
NEST_CONTROLLER_PORT=50051
# TLS for the gRPC listener; paths inside the container (/home/nest/.ssh is a
# private copy of NEST_SSH_DIR).
# NEST_TLS_CERT_FILE=/home/nest/.ssh/tls.crt
# NEST_TLS_KEY_FILE=/home/nest/.ssh/tls.key
# NEST_PUBLIC_URL=grpcs://nest.example.edu:50051

# --- Optional Mode A Tailnet transport (never needed for Mode B) ---------------
# Outbound Tailnet access: use compose.tailscale.yaml instead of compose.yaml.
# Auth key contents belong ONLY in this ignored file (Dokploy: ../files/tailscale/authkey).
NEST_TAILSCALE_AUTHKEY_FILE=./secrets/tailscale-authkey
NEST_TAILSCALE_HOSTNAME=nest-controller
# Override with a reviewed official image version or digest when updating.
NEST_TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4

# Shared-team inbound gRPC: use compose.tailscale-shared.yaml alone.
# Dokploy: ../files/tailscale/serve containing the reviewed serve.json.
NEST_TAILSCALE_SERVE_DIR=./docker/tailscale-serve
