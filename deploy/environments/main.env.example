# Main / development deployment of compose.dokploy.yaml (#118): one of two Dokploy
# Compose applications on the same host, deployed from the `main` branch. The other is
# release.env.example. Add these to this application's Environment panel, next to
# the settings it already has (HPC, Google sign-in, database password, ...).
#
# Every value that names this deployment differs from release.env.example. Every
# <...> is a placeholder to replace; nothing here is a credential. Never copy a
# secret, a database password, a session/OAuth secret or a Tailscale key from the
# other application: each has its own.
#
# Check it before every deploy, with the application's real appName and .env:
#
#   python3 scripts/nest-deploy-doctor.py preflight --project <main appName> --env-file <path to .env>
#
# See docs/source/multi-environment.md for the order of the steps, the migration of
# the existing staging application, and rollback.

# --- Identity ----------------------------------------------------------------------
# Dokploy's appName is the Compose project: it scopes every network, volume and
# container name. It is set when the application is created, not here.
COMPOSE_PROFILES='local-db,migrate,public-grpc,public-grpc-acme'

# --- gRPC origin network: private, and different from Release's ---------------------
# The existing staging values (docs/source/deployment-recovery.md); the gateway is
# the third host, clear of the Controller's dynamic address (#111).
NEST_GRPC_ORIGIN_SUBNET='10.253.250.0/28'
NEST_GRPC_GATEWAY_ADDRESS='10.253.250.3'
NEST_GRPC_TRUSTED_PROXIES='10.253.250.3/32'
# This origin subnet and this application's own Tailnet bridge, nothing else:
#   docker network inspect <main appName>_tailnet --format '{{(index .IPAM.Config 0).Subnet}}'
NEST_GRPC_ALLOWED_PEERS='10.253.250.0/28,<main tailnet bridge subnet>'

# --- Public gRPC gateway --------------------------------------------------------------
NEST_GRPC_PUBLIC_HOST='grpc.main.nest.cerulean.works'
# The alias Traefik's route dials on dokploy-network; unique on that network. Render
# the route with:
#   deploy/public-grpc/traefik/render.sh grpc.main.nest.cerulean.works <traefik version> --instance main
# Until the existing staging route is migrated, keep this application's current
# alias (docs/source/multi-environment.md, "Migrate the existing staging application").
NEST_GRPC_EDGE_ALIAS='nest-grpc-gateway-main'
NEST_GRPC_EDGE_PROXY='<traefik address on dokploy-network>/32'

# --- Certificate: its own ACME account and volume, Let's Encrypt STAGING ----------
NEST_GRPC_ACME_EMAIL='<ops contact>'
NEST_GRPC_ACME_ACCEPT_TOS='true'
# A Cloudflare token with Zone:DNS:Edit on this zone only; a separate token from
# Release's where practical, so either can be revoked alone.
NEST_GRPC_CLOUDFLARE_DNS_API_TOKEN='<main DNS-01 token>'
# Leave NEST_GRPC_ACME_SERVER unset (staging directory). Main's developers trust the
# staging root explicitly (NEST_CONTROLLER_TLS_CA_FILE) until a production
# certificate is approved for this name.

# --- Tailnet: its own node --------------------------------------------------------
# The existing application keeps its node and state volume. A new Main application
# would enrol its own node, with an operator-approved key.
NEST_TAILSCALE_HOSTNAME='<existing main hostname, such as nest-controller>'

# --- Web and sign-in (coordinate with #96; Main never uses Release's origin) ------
NEST_GOOGLE_REDIRECT_URL='https://main.nest.cerulean.works/auth/google/callback'
NEST_PUBLIC_URL='https://main.nest.cerulean.works'
NEST_CONSOLE_HOSTED_PROFILE='off'

# --- Database: this application's own PostgreSQL and volume -----------------------
# `postgres` is the local-db service of this Compose project; it is not on the edge
# network. preflight checks that no container there answers to that name.
NEST_DATABASE_URL='postgresql://nest@postgres:5432/nest'
NEST_DATABASE_REQUIRED='true'

# --- HPC: its own workdir; capacity shared with Release must be split -------------
# A workdir that no other deployment uses, on every Platform: here, or as the
# NEST_PLATFORM_<ID>_WORKDIR line of each Platform in NEST_PLATFORMS_ENV. If Main and
# Release use the same Slurm account, set limits whose sum with Release's stays
# within the operator-approved allocation (docs/source/multi-environment.md,
# "HPC capacity").
NEST_SLURM_WORKDIR='<cluster path>/nest-main'
NEST_LIMIT_ACTIVE_PER_PLATFORM='<main share>'

# --- Pilot profile (unchanged from docs/source/public-grpc-gateway.md) ------------
NEST_PUBLIC_PILOT='true'
NEST_CONTROLLER_AUTH='session'
NEST_EXECUTION_REGISTRY='required'
NEST_LIMIT_BATCH_SCRIPTS='refuse'
NEST_CONTROLLER_ALLOW_PLAINTEXT='true'
NEST_RESULT_TIMEOUT='600'
NEST_ENVIRONMENT_TIMEOUT='540'
NEST_PROVIDER_APPROVALS='database'
