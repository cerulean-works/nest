# Release / Early Access deployment of compose.dokploy.yaml (#118): one of two Dokploy
# Compose applications on the same host, deployed from one approved, immutable `v*`
# tag (first target v0.1.0a5, #116). The other is main.env.example. Create this as a
# new Dokploy application; never reuse the stopped legacy application or its volumes.
#
# Every value that names this deployment differs from main.env.example. Every <...>
# is a placeholder to replace; nothing here is a credential. Never copy a secret, a
# database password, a session/OAuth secret or a Tailscale key from the other
# application: each has its own.
#
# Check it before every deploy, with the application's real appName and .env:
#
#   python3 scripts/nest-deploy-doctor.py preflight --project <release appName> --env-file <path to .env>
#
# See docs/source/multi-environment.md for the order of the steps, the choice of
# starting data, and rollback.

# --- Identity ----------------------------------------------------------------------
COMPOSE_PROFILES='local-db,migrate,public-grpc,public-grpc-acme'

# --- gRPC origin network: private, and different from Main's -----------------------
NEST_GRPC_ORIGIN_SUBNET='10.253.251.0/28'
NEST_GRPC_GATEWAY_ADDRESS='10.253.251.3'
NEST_GRPC_TRUSTED_PROXIES='10.253.251.3/32'
# This origin subnet and this application's own Tailnet bridge, nothing else:
#   docker network inspect <release appName>_tailnet --format '{{(index .IPAM.Config 0).Subnet}}'
NEST_GRPC_ALLOWED_PEERS='10.253.251.0/28,<release tailnet bridge subnet>'

# --- Public gRPC gateway --------------------------------------------------------------
NEST_GRPC_PUBLIC_HOST='grpc.nest.cerulean.works'
# Render the route with:
#   deploy/public-grpc/traefik/render.sh grpc.nest.cerulean.works <traefik version> --instance release
NEST_GRPC_EDGE_ALIAS='nest-grpc-gateway-release'
NEST_GRPC_EDGE_PROXY='<traefik address on dokploy-network>/32'

# --- Certificate: its own ACME account and volume, Let's Encrypt STAGING ----------
NEST_GRPC_ACME_EMAIL='<ops contact>'
NEST_GRPC_ACME_ACCEPT_TOS='true'
NEST_GRPC_CLOUDFLARE_DNS_API_TOKEN='<release DNS-01 token>'
# Leave NEST_GRPC_ACME_SERVER unset (staging directory) until the operator approves
# the production directory for this name; that switch is part of H09 (#90).

# --- Tailnet: its own node, enrolled with an operator-approved key ----------------
NEST_TAILSCALE_HOSTNAME='nest-controller-release'
# A one-time, tagged (tag:nest-controller) auth key; empty it after enrolment.
NEST_TAILSCALE_AUTHKEY='<one-time key>'

# --- Web and sign-in (the canonical origin is #96's; do not flip H09 here) --------
NEST_GOOGLE_REDIRECT_URL='https://nest.cerulean.works/auth/google/callback'
NEST_PUBLIC_URL='https://nest.cerulean.works'
NEST_CONSOLE_HOSTED_PROFILE='off'

# --- Database: this application's own PostgreSQL and volume -----------------------
NEST_DATABASE_URL='postgresql://nest@postgres:5432/nest'
NEST_DATABASE_REQUIRED='true'
# Its own password, never Main's.
NEST_DATABASE_PASSWORD='<release database password>'

# --- HPC: its own workdir; capacity shared with Main must be split ----------------
NEST_SLURM_WORKDIR='<cluster path>/nest-release'
NEST_LIMIT_ACTIVE_PER_PLATFORM='<release share>'

# --- Pilot profile (unchanged from docs/source/public-grpc-gateway.md) ------------
NEST_PUBLIC_PILOT='true'
NEST_CONTROLLER_AUTH='session'
NEST_EXECUTION_REGISTRY='required'
NEST_LIMIT_BATCH_SCRIPTS='refuse'
NEST_CONTROLLER_ALLOW_PLAINTEXT='true'
NEST_RESULT_TIMEOUT='600'
NEST_ENVIRONMENT_TIMEOUT='540'
NEST_PROVIDER_APPROVALS='database'
