# Staging values for the public gRPC gateway pilot (H08), to add to the Dokploy
# Environment panel of an existing compose.dokploy.yaml deployment. Every <...> is a
# placeholder to replace; nothing here is a working value or a credential.
#
# Production DNS, the production name and production certificates are not touched by
# these values. Keep HOSTED_PROFILE_DEFAULT=False in the SDK (nest.config) until H09.
# Check the result before deploying:
#
#   python3 scripts/nest-deploy-doctor.py preflight --project <dokploy appName> --env-file <path to .env>
#
# See docs/source/public-grpc-gateway.md (Deploy to staging) and
# docs/source/deployment-recovery.md.

# --- Profiles: keep the ones already in use, then add the gateway ----------------
COMPOSE_PROFILES='local-db,migrate,public-grpc,public-grpc-acme'

# --- The internal origin network (gateway -> Controller) ---------------------------
# A private IPv4 /28 that no Docker network and no host route overlaps. The default
# 172.31.250.0/28 lies inside Docker's own default address pools (172.17.0.0/16 to
# 172.31.0.0/16) and collided on the 2026-11-26 deployment. The gateway address is
# the subnet's second host (the first is the bridge's own gateway).
NEST_GRPC_ORIGIN_SUBNET='<10.253.250.0/28>'
NEST_GRPC_GATEWAY_ADDRESS='<10.253.250.2>'

# --- Controller: the pilot profile (it refuses to start without every item) --------
NEST_PUBLIC_PILOT='true'
NEST_CONTROLLER_AUTH='session'
NEST_EXECUTION_REGISTRY='required'
NEST_LIMIT_BATCH_SCRIPTS='refuse'
# h2c only on grpc-origin and the Tailnet bridge; the gateway terminates public TLS.
NEST_CONTROLLER_ALLOW_PLAINTEXT='true'
# Exactly the gateway's address: the only peer whose x-forwarded-for is believed.
NEST_GRPC_TRUSTED_PROXIES='<NEST_GRPC_GATEWAY_ADDRESS>/32'
# The origin subnet and the Tailnet bridge, nothing else. Find the bridge with:
#   docker network inspect <appName>_tailnet --format '{{(index .IPAM.Config 0).Subnet}}'
NEST_GRPC_ALLOWED_PEERS='<NEST_GRPC_ORIGIN_SUBNET>,<tailnet bridge subnet>'
# Under the gateway's 1200 s idle and deadline bound.
NEST_RESULT_TIMEOUT='600'
NEST_ENVIRONMENT_TIMEOUT='540'
NEST_PROVIDER_APPROVALS='database'
# Small pilot admission limits (docs/source/admission-limits.md); examples only.
NEST_LIMIT_ACTIVE_PER_USER='2'
NEST_LIMIT_ACTIVE_PER_PROJECT='4'
NEST_LIMIT_SUBMISSIONS_PER_MINUTE='6'
# Calls per minute per client address and per Nest User (defaults 600 and 300).
NEST_GRPC_RATE_LIMIT_PER_PEER='120'
NEST_GRPC_RATE_LIMIT_PER_USER='60'

# --- Gateway ----------------------------------------------------------------------
NEST_GRPC_PUBLIC_HOST='<grpc.staging.example.org>'
# Dokploy's Traefik on dokploy-network, as a /32. Find it with:
#   docker inspect dokploy-traefik --format '{{(index .NetworkSettings.Networks "dokploy-network").IPAddress}}'
# If Dokploy recreates Traefik with another address the gateway refuses every
# connection until this is updated (it fails closed).
NEST_GRPC_EDGE_PROXY='<traefik address>/32'

# --- Certificate: ACME DNS-01 through Cloudflare, Let's Encrypt STAGING ------------
NEST_GRPC_ACME_EMAIL='<ops contact>'
# Only after reading the CA's terms of service.
NEST_GRPC_ACME_ACCEPT_TOS='true'
# A Cloudflare API token with Zone:DNS:Edit on this zone only. It reaches only the
# grpc-certificates container, as a secret file.
NEST_GRPC_CLOUDFLARE_DNS_API_TOKEN='<token>'
# Leave NEST_GRPC_ACME_SERVER unset for Let's Encrypt staging. The production
# directory is an H09 change, after approval.
