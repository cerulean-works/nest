# /etc/nest-monitor/nest-monitor.env, read by the nest-monitor units. No secret
# belongs here: the collectors read no credential and the probe sends none.

# The Compose project (Dokploy appName) of the Controller deployment.
NEST_MONITOR_PROJECT=nest-controllerpr-qkumfd
# The public gateway address and the CA that issued its staging certificate.
NEST_MONITOR_PROBE_ADDRESS=grpc.staging.example.org:443
NEST_MONITOR_PROBE_CA_FILE=/etc/nest-monitor/staging-ca.pem
